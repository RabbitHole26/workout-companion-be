NODE_ENV='dev' # accepted values: "dev" or "prod"
ORIGIN='http://localhost:5173' # base url, eg: "http://localhost:5173"
EMAIL_HOST='smtp.gmail.com' # SMTP host provided address
EMAIL_USERNAME='example@gmail.com' # email address
EMAIL_PASSWORD='password' # password generated by the SMTP provider
FROM_EMAIL='merndev26@gmail.com' # email address used to deliver password reset links
PORT='3000'
DB_URI='mongo_db_uri' # mongo DB URI
ACCESS_TOKEN_SECRET='access_token_secret'
REFRESH_TOKEN_SECRET='refresh_token_secret'
ACCESS_TOKEN_EXPIRY_PROD='5m' # default value: 5 minutes
REFRESH_TOKEN_EXPIRY_PROD='1d' # default value: 1 day
REFRESH_TOKEN_EXPIRY_SCHEMA_PROD="86400" # default value: 86400 seconds (1 day)
PASSWORD_TOKEN_EXPIRY_PROD='3600' # default value: 3600 seconds (1 hour)
ACCESS_TOKEN_EXPIRY_DEV='30s'
REFRESH_TOKEN_EXPIRY_DEV='10m'
REFRESH_TOKEN_EXPIRY_SCHEMA_DEV="600"
PASSWORD_TOKEN_EXPIRY_DEV='60'
COOKIE_MAXAGE_PROD='86400000' # default value: 86400000 milliseconds (1 day)
COOKIE_MAXAGE_DEV='600000'
CLOUDINARY_NAME='claudinary_name'
CLOUDINARY_API_KEY='claudinary_api_key'
CLOUDINARY_API_SECRET='claudinary_api_secret'
UA_PARSER_RESULT_KEYS='os-browser-engine' # default value for the keysArray used by the userAgentParser middleware